# Free Supabase projects are paused after about a week with no activity.
# This pings the database every 3 days so the shop never goes to sleep.
# Add two repository secrets: SUPABASE_URL and SUPABASE_KEY (the publishable/anon key).
name: Keep Supabase awake
on:
  schedule:
    - cron: "17 5 */3 * *"
  workflow_dispatch:
jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Ping the database
        run: |
          curl -fsS "${{ secrets.SUPABASE_URL }}/rest/v1/prices?select=name&limit=1" \
            -H "apikey: ${{ secrets.SUPABASE_KEY }}" -H "Authorization: Bearer ${{ secrets.SUPABASE_KEY }}"
